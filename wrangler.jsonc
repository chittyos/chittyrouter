// chittyrouter — Cloudflare Workers configuration
{
  "name": "chittyrouter",
  "main": "src/index-minimal.js",
  "compatibility_date": "2026-08-07",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "account_id": "0bc21e3a5a9de1a4cc843be9c3e98121",
  "workers_dev": false,
  "ai": {
    "binding": "AI"
  },
  "durable_objects": {
    "bindings": [
      { "name": "AI_STATE_DO", "class_name": "AIStateDO" },
      { "name": "SYNC_STATE", "class_name": "SyncStateDurableObject" },
      { "name": "TRIAGE_AGENT", "class_name": "TriageAgent" },
      { "name": "PRIORITY_AGENT", "class_name": "PriorityAgent" },
      { "name": "RESPONSE_AGENT", "class_name": "ResponseAgent" },
      { "name": "DOCUMENT_AGENT", "class_name": "DocumentAgent" },
      { "name": "ENTITY_AGENT", "class_name": "EntityAgent" },
      { "name": "EVIDENCE_AGENT", "class_name": "EvidenceAgent" },
      { "name": "CALENDAR_AGENT", "class_name": "CalendarAgent" },
      { "name": "FINANCE_AGENT", "class_name": "FinanceAgent" },
      { "name": "NOTIFICATION_AGENT", "class_name": "NotificationAgent" },
      { "name": "INTELLIGENCE_AGENT", "class_name": "IntelligenceAgent" },
      { "name": "WEBHOOK_AGENT", "class_name": "WebhookIngestionAgent" },
      { "name": "MESSAGING_AGENT", "class_name": "MessagingAgent" },
      { "name": "SECURITY_AGENT", "class_name": "SecurityAgent" },
      { "name": "SCRAPE_AGENT", "class_name": "ScrapeAgent" },
      { "name": "MCP_GATEWAY", "class_name": "ChittyRouterMcpGateway" }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_classes": ["AIStateDO", "SyncStateDurableObject"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": [
        "TriageAgent", "PriorityAgent", "ResponseAgent", "DocumentAgent",
        "EntityAgent", "EvidenceAgent", "CalendarAgent", "FinanceAgent",
        "NotificationAgent", "IntelligenceAgent", "WebhookIngestionAgent",
        "MessagingAgent"
      ]
    },
    {
      "tag": "v3",
      "new_sqlite_classes": ["ChittyRouterMcpGateway"]
    },
    {
      "tag": "v4",
      "new_sqlite_classes": ["SecurityAgent"]
    },
    {
      "tag": "v5",
      "new_sqlite_classes": ["ScrapeAgent"]
    }
  ],
  "vars": {
    "ENVIRONMENT": "production",
    "SERVICE_NAME": "ChittyRouter AI Gateway",
    "VERSION": "2.1.0-ai",
    "LOG_LEVEL": "WARN",
    "AI_MODEL_PRIMARY": "@cf/meta/llama-4-scout-17b-16e-instruct",
    "AI_MODEL_SECONDARY": "@cf/openai/gpt-oss-120b",
    "AI_MODEL_VISION": "@cf/meta/llama-3.2-11b-vision-instruct",
    "AI_MODEL_AUDIO": "@cf/openai/whisper",
    "AI_MODEL_REASONING": "@cf/google/gemma-4-26b-a4b-it",
    "PROJECT_ID": "chittyrouter",
    "CHITTY_ORG": "ChittyOS",
    "SESSION_REPO": "chittychat-sessions",
    "RANDOMNESS_BEACON": "true",
    "VERSION_MANAGEMENT": "enterprise",
    "CHITTYCONNECT_URL": "https://connect.chitty.cc",
    "CHITTYROUTER_URL": "https://router.chitty.cc",
    "CHITTYDISPUTE_URL": "https://dispute.chitty.cc",
    // Categories must match TriageAgent's CATEGORIES (src/agents/triage-agent.js).
    // isDisputeWorthy does exact set membership, so only triage-emitted names route.
    "DISPUTE_WORTHY_CATEGORIES": "lawsuit_communication,court_notice,emergency_legal",
    "ENABLE_ANALYTICS": "true",
    // Privilege-gate allowlist (src/config/privilege-gate.js → privilegedSenderDomains).
    // Non-secret. MUST live here in committed vars: `wrangler deploy` reconciles
    // plain_text vars from this file, so an out-of-band runtime var would be
    // dropped on the next deploy. Active only as a privilege gate; routing is
    // unchanged. The alias_registry overlay stays dormant until the
    // ALIAS_REGISTRY_ENABLED kill-switch is set (intentionally absent here).
    "PRIVILEGED_SENDER_DOMAINS": "ksnlaw.com,bertonring.com,vanguardadvocates.com",
    // Lane-2 (property/mgmt) consolidation forward target. Non-secret. Read ONLY
    // by the alias_registry overlay, dormant until ALIAS_REGISTRY_ENABLED — inert
    // today. Committed so wrangler deploy does not drop it.
    "FORWARD_LANE2_OPS": "ops@aribia.llc"
    // COMPTROLLER_HMAC_KEY is a SECRET (not a var) — set via:
    //   wrangler secret put COMPTROLLER_HMAC_KEY
    // It MUST equal the same secret on the chittycomptroller worker
    // (chittyops/services/comptroller), which signs L2 DegradeSignals with it.
    // Used by /admin/tier-degrade to verify X-Comptroller-Signature. Route via
    // chico (ChittyConnect concierge) — never paste the value here.
  },
  // mcp.chitty.cc/* route removed — owned by chittyconnect (canonical MCP gateway).
  //
  // router.chitty.cc/* is currently configured directly on the worker via the
  // Cloudflare dashboard (Workers > chittyrouter > Settings > Triggers). It is
  // NOT managed here because the Workers Builds build-token used by the
  // canonical deploy path lacks the `Zone: Workers Routes: Edit` permission
  // for the chitty.cc zone (7a4f759e0928fb2be4772a2f72ad0df2). With a `routes`
  // block here, every Workers Build fails post-upload on the route attachment
  // step (`/zones/.../workers/routes` → 10000 Authentication error) even
  // though the worker itself uploads cleanly.
  //
  // To restore IaC for routes: widen the build token's permissions in the
  // dashboard (Workers > chittyrouter > Settings > Build), then add the
  // routes block back here. Until then, treat dashboard route config as
  // canonical for this worker.
  "email": [
    {
      "name": "chittyrouter-email",
      "destination_addresses": [
        "*@chitty.cc",
        "*-v-*@chitty.cc",
        "case-*@chitty.cc",
        "matter-*@chitty.cc",
        "intake@chitty.cc",
        "legal@chitty.cc",
        "evidence@chitty.cc",
        "calendar@chitty.cc"
      ]
    }
  ],
  // Hyperdrive → neondb-chittyos-core (Neon project restless-grass-40598426 /
  // neondb, main pooled host ep-green-water-ael1lksw-pooler...). Read by
  // src/database.js (env.HYPERDRIVE) and src/config/alias-registry.js. Adding
  // this binding fixes the pre-existing gap where env.HYPERDRIVE was read but
  // never declared on the active config. Harmless while the alias_registry
  // overlay kill-switch (ALIAS_REGISTRY_ENABLED) is unset.
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "1d126444cff1416cb415447e6cc6d15a"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "AI_CACHE",
      "id": "59af99e1f7994a6282a0823bfb89bda0"
    }
  ],
  "r2_buckets": [
    {
      "binding": "DOCUMENT_STORAGE",
      "bucket_name": "chittyrouter-documents"
    },
    {
      "binding": "WEBHOOK_STORAGE",
      "bucket_name": "notion-webhook"
    }
  ],
  "tail_consumers": [
    {
      "service": "chittytrack"
    }
  ],
  "limits": {
    "cpu_ms": 30000
  },
  "triggers": {
    "crons": [
      "0 */6 * * *",
      "0 0 * * *",
      "*/30 * * * *",
      "0 */2 * * *",
      "*/15 * * * *"
    ]
  },
  "services": [
    { "binding": "CHITTYAUTH", "service": "chittyauth", "entrypoint": "ChittyAuthService" },
    // Auth sidecar — ADR-000 Decision 2
    { "binding": "CHITTYAUTH", "service": "chittyauth", "entrypoint": "ChittyAuthService" }
  ],
  "placement": {
    "mode": "smart"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 0.1,
      "persist": false,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "persist": false,
      "head_sampling_rate": 0.1
    }
  }
}
